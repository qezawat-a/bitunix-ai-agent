# ================= Bitunix (create at bitunix.com > API Management; enable Futures trading permission)
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=
MARGIN_COIN=USDT
# Start in paper mode. Every order is validated but NOT sent. Set false when you are ready.
DRY_RUN=true
# Optional. Leave empty unless Bitunix is blocked. Use your VPN app's HTTP/SOCKS port (NOT 8080).
# BITUNIX_PROXY=http://127.0.0.1:10809

# ================= Brain (any one)
# openai | anthropic | deepseek | openrouter | dashscope | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=          # for custom OpenAI-compatible servers
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ROUNDS=16

# ================= Personality / behaviour
AGENT_NAME=J-Rock
TIMEZONE=Asia/Tehran
WATCH_SYMBOLS=BTCUSDT,ETHUSDT
# always | never | above   (above = only ask for trades bigger than CONFIRM_ABOVE_NOTIONAL USDT)
CONFIRM_TRADES=always
CONFIRM_ABOVE_NOTIONAL=500

# ================= Guard rails (0 = off). Violations come back as an adjusted plan, never a flat "no".
RISK_MAX_LEVERAGE=50
RISK_MAX_POSITION_NOTIONAL=0
RISK_MAX_RISK_PER_TRADE_PCT=0
RISK_DAILY_LOSS_LIMIT=0
RISK_REQUIRE_STOP_LOSS=false
RISK_SYMBOL_ALLOWLIST=

# ================= Telegram (from @BotFather). Put YOUR numeric user id in the allow list.
TELEGRAM_BOT_TOKEN=
# If Telegram is filtered on your network: point it at your VPN app's local proxy (v2rayNG default socks5://127.0.0.1:10808,
# Clash/NekoBox http://127.0.0.1:7890 or socks5://127.0.0.1:2080) ...
TELEGRAM_PROXY=
# ... or at a Telegram Bot API mirror (e.g. your own Cloudflare Worker).
TELEGRAM_API_URL=
TELEGRAM_ALLOWED_USER_IDS=

# ================= Slack (Socket Mode app: xoxb- bot token + xapp- app token)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# If Slack is blocked on your network: your VPN app's local HTTP proxy (v2rayNG http://127.0.0.1:10809, Clash http://127.0.0.1:7890)
SLACK_PROXY=
SLACK_ALLOWED_USER_IDS=

# ================= HTTP / WebSocket API (your Android app, Agent Trader, anything)
# The address J-Rock LISTENS on inside the server. Keep 0.0.0.0. Never put your domain here
# (a domain is ignored and replaced by 0.0.0.0). Your domain goes in Railway > Settings > Networking.
API_HOST=0.0.0.0
# Railway: leave empty (8080 is used) and point the domain's target port at 8080.
API_PORT=8080
# Long random secret. Every API call needs the header  Authorization: Bearer <API_TOKEN>.
# It is also the "API key" for OpenAI-compatible apps (Base URL = https://your-domain, Model = j-rock).
# Without it the API only answers requests from the same machine. Set it in Railway Variables, never commit it.
API_TOKEN=

# ================= Storage
# Optional but recommended on Railway: a Postgres URL (Neon, Supabase, Railway Postgres).
# With it, chat memory, journal, alerts, tasks, settings set from chat, skills, MCP servers and custom tools
# are kept in the database and survive every redeploy. Neon: copy the connection string (with ?sslmode=...).
# If the database can't be reached, J-Rock keeps running on the local SQLite file and /health shows why.
DATABASE_URL=
# Local SQLite file, used when DATABASE_URL is empty.
DB_PATH=data/agent.db

# ================= Self-coding (J-Rock edits, tests, commits and pushes code)
# GitHub token (classic, "repo" scope). Lets J-Rock clone private repos and push its own fixes,
# which makes Railway redeploy. Can also be set from chat:  set GITHUB_TOKEN=ghp_...
GITHUB_TOKEN=
# Folder for projects J-Rock clones and works on (default ~/jrock-projects; Railway image: /app/data/projects)
WORKSPACE_DIR=
# Max seconds per shell command it runs (default 300)
SHELL_TIMEOUT=300

# ---- LLM rate limits: one request at a time, retry on HTTP 429/5xx
LLM_MAX_CONCURRENCY=1
LLM_RETRIES=3
# ---- Code-side GUARD (no LLM needed): breakeven at ROI>=15%, trailing at ROI>=20% with 1% callback
AUTO_GUARD=true
AUTO_GUARD_BE_ROI=15
AUTO_GUARD_TRAIL_ROI=20
AUTO_GUARD_TRAIL_CALLBACK=1.0
# ---- Code-side scan + report (no LLM). All changeable from chat: set NAME=value ; "scan" shows them.
AUTO_SCAN=false
SCAN_SYMBOLS=PORTALUSDT
SCAN_TIMEFRAMES=1m,3m,5m,15m
SCAN_EVERY_SEC=15
SCAN_STRATEGIES=ema,macd,rsi,stoch,vwap
SCAN_MIN_STRATEGIES=2
SCAN_MIN_TF_CONF=60
SCAN_MIN_AGREE_TF=2
SCAN_MIN_OVERALL=70
SCAN_LEVERAGE=30
SCAN_MARGIN_MODE=CROSS
SCAN_MARGIN_PCT=25
SCAN_SL_ATR=0.5
SCAN_TP_LADDER=1.5:25,2.5:25,3.5:50
SCAN_MAX_POSITIONS=1
REPORT_EVERY_SEC=0
